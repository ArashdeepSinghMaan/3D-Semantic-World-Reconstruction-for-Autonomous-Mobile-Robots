<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lidar_pointcloud_processing</name>
  <version>0.1.0</version>
  <description>
    Phase 1 of the 3D semantic world reconstruction project: configurable
    LiDAR PointCloud2 preprocessing (invalid/zero-point removal, range and
    crop-box filtering, voxel downsampling, outlier removal), diagnostics,
    live and offline inspection tools, and Phase 1 experiments.
  </description>
  <maintainer email="arashdeepsingh1512@gmail.com">ArashdeepSingh</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- open3d and rosbags are installed with pip: see requirements.txt -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
