Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/PointCloud2
      Name: World Points
      Topic: /world_reconstruction/points
      Size (m): 0.03
      Style: Points
      Color Transformer: RGB8
    - Class: rviz_default_plugins/PointCloud2
      Name: Accumulated World Reconstruction
      Topic: /world_reconstruction/accumulated
      Size (m): 0.03
      Style: Points
      Color Transformer: FlatColor
  Global Options:
    Fixed Frame: map
  Name: root
