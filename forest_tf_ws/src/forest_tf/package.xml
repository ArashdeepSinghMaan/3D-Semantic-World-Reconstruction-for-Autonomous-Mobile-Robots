<?xml version="1.0"?>
<package format="3">
  <name>forest_tf</name>
  <version>0.1.0</version>
  <description>Build the Forest dataset TF tree from Unitree body odometry and recorded static transforms.</description>
  <maintainer email="arashdeep.singh@hitechroboticsystemz.com">hitech</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
