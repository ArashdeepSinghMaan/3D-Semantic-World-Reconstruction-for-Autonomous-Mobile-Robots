<?xml version="1.0"?>
<package format="3">
  <name>world_frame_reconstruction</name>
  <version>0.1.0</version>
  <description>Phase 7 world-frame reconstruction for semantic 3D observations using ROS 2 TF.</description>
  <maintainer email="arashdeepsingh1512@gmail.com">Arashdeep Singh</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>libpcl-all-dev</depend>

  <export>
