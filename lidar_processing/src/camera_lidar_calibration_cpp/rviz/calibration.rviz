Panels:
  - Class: rviz_common/Displays
    Name: Displays

Visualization Manager:
  Class: ""

  Displays:
    - Class: rviz_default_plugins/Image
      Name: Camera-LiDAR Overlay
      Topic: /camera_lidar/overlay
      Enabled: true

    - Class: rviz_default_plugins/PointCloud2
      Name: Projected LiDAR
      Topic: /camera_lidar/projected_points
      Style: Points
      Size (Pixels): 3
      Enabled: true

  Global Options:
    Fixed Frame: os_lidar
