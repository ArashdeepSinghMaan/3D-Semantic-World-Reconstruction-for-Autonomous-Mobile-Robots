<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>geometric_pointcloud_analysis</name>
  <version>0.1.0</version>
  <description>
    Phase 2 of the 3D semantic world reconstruction project: ground segmentation
    (constrained RANSAC and a piecewise-planar grid), Euclidean clustering,
    surface normals and curvature, bounding boxes (AABB, PCA, gravity-aligned),
    shape features, RViz markers, diagnostics and offline experiments.
  </description>
  <maintainer email="arashdeepsingh1512@gmail.com">ArashdeepSingh</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>lidar_pointcloud_processing</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- open3d (optional: surface reconstruction and 3D viewer) is installed with pip -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
